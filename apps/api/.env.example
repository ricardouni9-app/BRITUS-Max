# BRITUS API — variáveis de ambiente (exemplo). NÃO versionar valores reais.
# Copie para `.env` (não versionado) e ajuste. Segredos entram só no ambiente de execução.

# Modo de execução: api | pilot | commercial
BRITUS_MODE=commercial

# Backend de persistência do modo comercial: memory | postgres
#  - memory   : demo local sem banco (dados voláteis; exige DEMO_OPERATOR_* p/ login)
#  - postgres : operação real (exige DATABASE_URL + migrações aplicadas)
BRITUS_DB=postgres

# String de conexão PostgreSQL (obrigatória quando BRITUS_DB=postgres).
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgres://britus:CHANGE_ME@127.0.0.1:5432/britus

# Rede
HOST=0.0.0.0
PORT=3000

# Cookie de sessão seguro (Secure) — 1/true quando servido sob HTTPS (produção).
COOKIE_SECURE=0

# TTL da sessão em segundos (default 8h).
SESSION_TTL_SECONDS=28800

# Log: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# Operador de DEMONSTRAÇÃO — SOMENTE BRITUS_DB=memory (provisionado no boot, nunca via HTTP).
# Em postgres, criar o primeiro operador via `npm run bootstrap` (ver docs/OPERATIONS.md).
DEMO_OPERATOR_EMAIL=
DEMO_OPERATOR_PASSWORD=

# --- Bootstrap do primeiro operador (postgres) — usadas apenas pelo script `npm run bootstrap` ---
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Operador
BOOTSTRAP_ORG_NAME=Organização

# Recuperação de senha pelo Brevo. Valores próprios e exclusivos do BRITUS.
PUBLIC_BASE_URL=https://DOMINIO_DO_BRITUS
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=BRITUS
